{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>tjwise99/wise-renovate#v1.0.0"],
  "packageRules": [
    { "matchDatasources": ["docker"], "matchPackageNames": ["ghcr.io/tjwise99/wisekiosk"], "enabled": false }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/publish\\.yml$/"],
      "matchStrings": ["cosign-release: (?<currentValue>v[0-9.]+)"],
      "depNameTemplate": "sigstore/cosign",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/publish\\.yml$/"],
      "matchStrings": ["syft-version: (?<currentValue>v[0-9.]+)"],
      "depNameTemplate": "anchore/syft",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/publish/verify_release\\.py$/"],
      "matchStrings": ["check-jsonschema==(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "check-jsonschema",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ]
}
