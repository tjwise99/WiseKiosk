// Views over the WiseKiosk model. Each view renders to a browser-free Mermaid
// artifact (`just arch-export`).
//
// A view renders parallel relationships as one edge unless it asks for them
// separately; `multiple true` is that request, and a title overrides the label
// of a merge left in place (ADR 0020 rev 1).

views {
  // Named `index` so it is LikeC4's default landscape view — this avoids a
  // redundant auto-generated `index` view (and a stray artifact) alongside it.
  view index {
    title 'WiseKiosk — System Context (C4 L1)'
    include *

    // Naming a container here would draw it, so this level labels the merge
    // rather than splitting it. The title is independent of what it merges.
    include operator -> wisekiosk with {
      title 'Configures the deployment and supplies its secrets'
    }
  }

  view containers of wisekiosk {
    title 'WiseKiosk — Containers (C4 L2)'
    include *

    include operator -> backend with {
      multiple true
    }
    include frontend -> backend with {
      multiple true
    }
  }

  view backendComponents of wisekiosk.backend {
    title 'WiseKiosk Backend — Components (C4 L3)'
    include *
  }

  view frontendComponents of wisekiosk.frontend {
    title 'WiseKiosk Frontend — Components (C4 L3)'
    include *

    // `include *` draws this container's children and what they relate to, not
    // what the container itself relates to. Naming the Viewer draws it and the
    // edge to it (ADR 0021 rev 1).
    include viewer
  }
}
