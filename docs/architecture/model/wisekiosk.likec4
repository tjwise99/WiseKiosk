// WiseKiosk architecture model — C4 System Context (L1) and Container (L2).
//
// Single source of truth for the diagrams in ../ARCHITECTURE.md. Edit here, then
// run `just arch-export` (ADR 0003).
//
// A tag parses only as the first entry of an element or relationship body.
//
// Boundary, actors and external systems are ADR 0019's; the containers, the one
// origin they share and the tag tier here are ADR 0020's.

specification {
  element person {
    style {
      shape person
    }
  }
  element system
  element container

  // A tag carries the Doorstop id of the requirement obliging the tagged element
  // or relationship. The Context level answers to SYS and the Container level to
  // SRS; a relationship spanning both carries one of each (ADR 0019, ADR 0020).
  tag SYS001
  tag SYS002
  tag SYS003
  tag SRS001
  tag SRS003
  tag SRS005
  tag SRS006
  tag SRS009
  tag SRS010
  tag SRS016
  tag SRS017
  tag SRS018
  tag SRS022
  tag SRS026
  tag SRS028
}

model {
  operator = person 'Operator' {
    description 'Deploys WiseKiosk, authors its configuration and supplies its secrets.'
  }

  viewer = person 'Viewer' {
    description 'Reads the display. Provides no input to the system.'
  }

  wisekiosk = system 'WiseKiosk' {
    description '''
      Full-screen, config-driven smart-mirror display. The boundary is what
      deploys: the published container image and what it serves.
    '''

    backend = container 'Backend' {
      #SRS009
      #SRS022
      technology 'Go'
      icon tech:go
      description '''
        Stateless HTTP proxy and static file server. Answers one route per
        upstream source, shaping each response into the payload the boundary
        schema defines, and serves the frontend bundle and the configuration
        file as static content it never interprets.
      '''
    }

    frontend = container 'Frontend' {
      #SRS005
      #SRS017
      technology 'Svelte 5, static single-page bundle'
      icon tech:svelte
      description '''
        Runs in the browser on the display host. Validates the configuration
        before applying it, assembles the configured modules into one
        full-screen layout, and renders each payload into its module region.
      '''
    }

    backend -> frontend 'Serves the single-page bundle' {
      #SRS028
      technology 'HTTP'
    }

    frontend -> backend 'Fetches each module payload, and the configuration the backend serves unparsed' {
      #SRS003
      #SRS010
      #SRS016
      technology 'HTTP / JSON'
    }
  }

  operator -> backend 'Supplies each source secret, and the configuration the backend only serves' {
    #SYS003
    #SRS006
    #SRS018
  }

  frontend -> viewer 'Renders the configured modules, and legibly says when one failed' {
    #SYS001
    #SYS002
    #SRS001
    #SRS026
  }
}
