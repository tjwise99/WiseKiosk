// WiseKiosk architecture model — C4 System Context (L1).
//
// Single source of truth for the diagrams in ../ARCHITECTURE.md. Edit here, then
// run `just arch-export` (ADR 0003).
//
// Boundary, actors, external systems and the tag tier are ADR 0019's.

specification {
  element person {
    style {
      shape person
    }
  }
  element system

  // A tag carries the Doorstop id of the requirement obliging the tagged element
  // or relationship; at this level that tier is SYS (ADR 0019).
  tag SYS001
  tag SYS002
  tag SYS003
}

model {
  operator = person 'Operator' {
    description 'Deploys WiseKiosk, authors its configuration and supplies its secrets.'
  }

  viewer = person 'Viewer' {
    description 'Reads the display. Provides no input to the system.'
  }

  wisekiosk = system 'WiseKiosk' {
    description '''
      Full-screen, config-driven smart-mirror display. The boundary is what
      deploys: the published container image and what it serves.
    '''
  }

  operator -> wisekiosk 'Configures the deployment and supplies its secrets' {
    #SYS003
  }

  wisekiosk -> viewer 'Renders the configured modules, and legibly says when one failed' {
    #SYS001
    #SYS002
  }
}
