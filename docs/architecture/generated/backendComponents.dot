digraph {
    graph [TBbalance=min,
        bgcolor=transparent,
        compound=true,
        fontname=Arial,
        fontsize=20,
        labeljust=l,
        labelloc=t,
        layout=dot,
        likec4_viewId=backendComponents,
        nodesep=1.528,
        outputorder=nodesfirst,
        pad=0.209,
        rankdir=TB,
        ranksep=1.667,
        splines=spline
    ];
    node [color="#2563eb",
        fillcolor="#3b82f6",
        fontcolor="#eff6ff",
        fontname=Arial,
        penwidth=0,
        shape=rect,
        style=filled
    ];
    edge [arrowsize=0.75,
        color="#8D8D8D",
        fontcolor="#C9C9C9",
        fontname=Arial,
        fontsize=14,
        penwidth=2,
        style=""
    ];
    subgraph cluster_backend {
        graph [color="#1b3d88",
            fillcolor="#194b9e",
            label=<<FONT POINT-SIZE="11" COLOR="#bfdbfeb3"><B>BACKEND</B></FONT>>,
            likec4_depth=1,
            likec4_id="wisekiosk.backend",
            likec4_level=0,
            margin=40,
            style=filled
        ];
        staticserving [height=2.5,
            label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="4"><TR><TD><FONT POINT-SIZE="20">Static serving</FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#bfdbfe">Serves the frontend bundle and the<BR/>configuration file as bytes,<BR/>interpreting neither. The configuration is<BR/>not in the image and is<BR/>read from the served tree on each request for</FONT></TD></TR></TABLE>>,
            likec4_id="wisekiosk.backend.staticServing",
            likec4_level=1,
            margin="0.223,0.223",
            width=4.445];
        routehandler [group="wisekiosk.backend",
            height=2.5,
            label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="4"><TR><TD><FONT POINT-SIZE="20">Route handler</FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#bfdbfe">Serves one route per upstream source. Owns<BR/>the order the other<BR/>parts run in, and calls the module's shaping<BR/>functions to build the<BR/>upstream request and to parse what comes back</FONT></TD></TR></TABLE>>,
            likec4_id="wisekiosk.backend.routeHandler",
            likec4_level=1,
            margin="0.223,0.223",
            width=4.445];
        weathershaping [group="wisekiosk.backend",
            height=2.5,
            label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="4"><TR><TD><FONT POINT-SIZE="20">Weather shaping</FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#bfdbfe">The weather module's half of this container.<BR/>Serves the route the<BR/>boundary schema declares for it: reads the<BR/>location out of the<BR/>request through the type generated from that</FONT></TD></TR></TABLE>>,
            likec4_id="wisekiosk.backend.weatherShaping",
            likec4_level=1,
            margin="0.223,0.223",
            width=4.445];
        responsecache [group="wisekiosk.backend",
            height=2.5,
            label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="4"><TR><TD><FONT POINT-SIZE="20">Response cache</FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#bfdbfe">Holds a route's last success and last<BR/>failure, each for the interval<BR/>that route's entry sets, so a display refresh<BR/>no faster than the<BR/>interval reaches no upstream.</FONT></TD></TR></TABLE>>,
            likec4_id="wisekiosk.backend.responseCache",
            likec4_level=1,
            margin="0.223,0.223",
            width=4.445];
        upstreamclient [group="wisekiosk.backend",
            height=2.5,
            label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="4"><TR><TD><FONT POINT-SIZE="20">Upstream client</FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#bfdbfe">Makes the outbound request a route calls for,<BR/>under that route's<BR/>timeout, response-size ceiling and<BR/>request-rate bound, and<BR/>resolves the source's secret as it goes.</FONT></TD></TR></TABLE>>,
            likec4_id="wisekiosk.backend.upstreamClient",
            likec4_level=1,
            margin="0.223,0.223",
            width=4.445];
        requestrejection [group="wisekiosk.backend",
            height=2.5,
            label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="4"><TR><TD><FONT POINT-SIZE="20">Request rejection</FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#bfdbfe">Holds the rejection a request that does not<BR/>conform is answered<BR/>with: a status distinct to its cause, and a<BR/>body the frontend can<BR/>render, one shape for every route so no</FONT></TD></TR></TABLE>>,
            likec4_id="wisekiosk.backend.requestRejection",
            likec4_level=1,
            margin="0.223,0.223",
            width=4.445];
    }
    operator [height=2.5,
        label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="4"><TR><TD><FONT POINT-SIZE="20">Operator</FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#bfdbfe">Deploys WiseKiosk, authors its configuration<BR/>and supplies its secrets.</FONT></TD></TR></TABLE>>,
        likec4_id=operator,
        likec4_level=0,
        margin="0.223,0.223",
        width=4.445];
    operator -> staticserving [arrowhead=normal,
        label=<<TABLE BORDER="0" CELLPADDING="3" CELLSPACING="0" BGCOLOR="#18191BA0"><TR><TD ALIGN="TEXT" BALIGN="LEFT"><FONT POINT-SIZE="14">Places the configuration into the served<BR/>tree</FONT></TD></TR></TABLE>>,
        likec4_id="1e7aom1",
        style=dashed];
    operator -> upstreamclient [arrowhead=normal,
        label=<<TABLE BORDER="0" CELLPADDING="3" CELLSPACING="0" BGCOLOR="#18191BA0"><TR><TD ALIGN="TEXT" BALIGN="LEFT"><FONT POINT-SIZE="14">Supplies the secret for each source</FONT></TD></TR></TABLE>>,
        likec4_id="1tc54c3",
        style=dashed];
    frontend [height=2.5,
        label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="4"><TR><TD ROWSPAN="3" WIDTH="76"> </TD><TD ALIGN="TEXT" BALIGN="LEFT"><FONT POINT-SIZE="20">Frontend</FONT></TD><TD ROWSPAN="3" WIDTH="16"> </TD></TR><TR><TD ALIGN="TEXT" BALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#bfdbfe">Svelte 5, static single-page bundle</FONT></TD></TR><TR><TD ALIGN="TEXT" BALIGN="LEFT"><FONT POINT-SIZE="15" COLOR="#bfdbfe">Runs in the browser on the display<BR/>host. Validates the configuration<BR/>before applying it, assembles the<BR/>configured modules into one<BR/>full-screen layout, and renders</FONT></TD></TR></TABLE>>,
        likec4_id="wisekiosk.frontend",
        likec4_level=0,
        margin="0.112,0.223",
        width=4.445];
    frontend -> staticserving [arrowhead=normal,
        label=<<TABLE BORDER="0" CELLPADDING="3" CELLSPACING="0" BGCOLOR="#18191BA0"><TR><TD ALIGN="TEXT" BALIGN="LEFT"><FONT POINT-SIZE="14">Fetches the configuration, served back<BR/>unparsed</FONT></TD></TR><TR><TD ALIGN="TEXT" BALIGN="LEFT"><FONT POINT-SIZE="12">[ HTTP ]</FONT></TD></TR></TABLE>>,
        likec4_id="2s7h6s",
        style=dashed];
    frontend -> routehandler [arrowhead=normal,
        label=<<TABLE BORDER="0" CELLPADDING="3" CELLSPACING="0" BGCOLOR="#18191BA0"><TR><TD ALIGN="TEXT" BALIGN="LEFT"><FONT POINT-SIZE="14">Fetches the payload for each module</FONT></TD></TR><TR><TD ALIGN="TEXT" BALIGN="LEFT"><FONT POINT-SIZE="12">[ HTTP / JSON ]</FONT></TD></TR></TABLE>>,
        likec4_id=sz6227,
        style=dashed];
    staticserving -> frontend [arrowhead=normal,
        label=<<TABLE BORDER="0" CELLPADDING="3" CELLSPACING="0" BGCOLOR="#18191BA0"><TR><TD ALIGN="TEXT" BALIGN="LEFT"><FONT POINT-SIZE="14">Serves the single-page bundle</FONT></TD></TR><TR><TD ALIGN="TEXT" BALIGN="LEFT"><FONT POINT-SIZE="12">[ HTTP ]</FONT></TD></TR></TABLE>>,
        likec4_id="1pxlndw",
        style=dashed];
    routehandler -> responsecache [arrowhead=normal,
        label=<<TABLE BORDER="0" CELLPADDING="3" CELLSPACING="0" BGCOLOR="#18191BA0"><TR><TD ALIGN="TEXT" BALIGN="LEFT"><FONT POINT-SIZE="14">Asks for a held answer, and stores what<BR/>it gets</FONT></TD></TR></TABLE>>,
        likec4_id=aevzxg,
        minlen=1,
        style=dashed,
        weight=2];
    routehandler -> upstreamclient [arrowhead=normal,
        label=<<TABLE BORDER="0" CELLPADDING="3" CELLSPACING="0" BGCOLOR="#18191BA0"><TR><TD ALIGN="TEXT" BALIGN="LEFT"><FONT POINT-SIZE="14">Asks for a fresh response when nothing<BR/>is held</FONT></TD></TR></TABLE>>,
        likec4_id=zjyqy3,
        style=dashed,
        weight=3];
    weathershaping -> requestrejection [arrowhead=normal,
        label=<<TABLE BORDER="0" CELLPADDING="3" CELLSPACING="0" BGCOLOR="#18191BA0"><TR><TD ALIGN="TEXT" BALIGN="LEFT"><FONT POINT-SIZE="14">Answers a request it will not carry with<BR/>the shared rejection</FONT></TD></TR></TABLE>>,
        likec4_id=xj10jy,
        style=dashed];
    openmeteo [height=2.5,
        label=<<TABLE BORDER="0" CELLPADDING="0" CELLSPACING="4"><TR><TD><FONT POINT-SIZE="20">Open-Meteo</FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#bfdbfe">The weather service the weather module reads.<BR/>Run by somebody else and<BR/>outside the boundary. Which service this is,<BR/>is an edit to this<BR/>repository: no requirement names it, and the</FONT></TD></TR></TABLE>>,
        likec4_id=openMeteo,
        likec4_level=0,
        margin="0.223,0.223",
        width=4.445];
    upstreamclient -> openmeteo [arrowhead=normal,
        label=<<TABLE BORDER="0" CELLPADDING="3" CELLSPACING="0" BGCOLOR="#18191BA0"><TR><TD ALIGN="TEXT" BALIGN="LEFT"><FONT POINT-SIZE="14">Fetches the weather for the location a<BR/>request names</FONT></TD></TR><TR><TD ALIGN="TEXT" BALIGN="LEFT"><FONT POINT-SIZE="12">[ HTTPS ]</FONT></TD></TR></TABLE>>,
        likec4_id="1k7wp9t",
        minlen=1,
        style=dashed];
}
