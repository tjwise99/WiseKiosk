# Go
/bin/
*.exe
*.out
/backend/**/*.test

# The bring-up check's own working directory — the release assets it downloads and the
# configuration it copies from them (docs/CI.md § Deployment and bring-up).
/bring-up/

# Node / frontend build
node_modules/
dist/
.vite/
frontend/.svelte-check/

# Node dev tooling (LikeC4) — siloed beside the architecture model it serves;
# installed on demand from the committed lockfile, never committed. (Covered by
# the blanket node_modules/ above; spelled out for parity with the Python silo.)
docs/architecture/node_modules/

# The interactive webcomponent bundle `likec4 codegen webcomponent` produces (ADR 0003 rev 4) —
# regenerated by every `arch-export` and embedded into the docs site, never committed.
docs/architecture/embed/

# Secrets and env — never committed (secrets are delivered, not configured)
.env
.env.*
*.local
secrets/

# Python dev tooling — Doorstop runs from a local venv siloed beside the
# requirements it serves.
docs/requirements/.venv/

# Python dev tooling — the Sphinx docs site runs from a local venv siloed
# beside it (docs/site/); the need objects generated from the Doorstop tree
# and the built HTML are both regenerated on demand, never committed.
docs/site/.venv/
docs/site/generated/
docs/site/_build/

# Node dev tooling (Swagger UI for the API explorer page) — siloed beside the
# docs site it serves; installed on demand from the committed lockfile, never
# committed. (Covered by the blanket node_modules/ above; spelled out for
# parity with the Python silo.)
docs/site/node_modules/

# Swagger UI + a copy of boundary/openapi.yaml, placed for the Sphinx build by
# copy_explorer_assets.py — regenerated every build, never committed.
docs/site/vendor/

# Python dev tooling — pre-commit runs from a local venv siloed beside the
# hook scripts it invokes (scripts/).
scripts/.venv/

# Generated boundary contract and configuration types — produced at build time, when missing, by
# each consumer's own toolchain, never committed (ADR 0008 rev 6, ADR 0022 rev 3).
backend/internal/boundary/boundary.gen.go
frontend/src/lib/boundary/client.ts
frontend/src/config/types.ts

# Coverage / logs
coverage/
*.log

# Python bytecode — the checks in scripts/ run from the siloed venvs and leave this behind
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Agent worktrees
.claude/worktrees/

# Agent notes — machine-local tool traps and owner rulings that no tracked
# document guarantees. The layering is CLAUDE.md's. (`*.local` above does not
# reach this: it matches names ending in `.local`, not `.local.md`.)
CLAUDE.local.md

# Claude Code's per-machine permission grants — written by the tool, never
# committed. (`*.local` misses `.local.json` the same way it misses `.local.md`,
# and an unignored copy reds `check-untracked` while being unaddable.)
.claude/settings.local.json

# Playwright's own output — the render tier's traces, reports and per-test artifacts.
frontend/test-results/
frontend/playwright-report/

# A local configuration for `just dev`, served from Vite's static directory. A deployment's
# configuration is bind-mounted into the served tree and is never committed (ADR 0021 rev 4,
# ADR 0020 rev 4), so neither is the local stand-in for it.
frontend/public/config.json

# The deployment's own configuration, the file deploy/compose.yaml bind-mounts into the served
# tree. Site-specific by construction — it carries the installation's coordinates — and a
# coordinate committed here is in the history irreversibly. deploy/config.example.json is the
# tracked shape.
deploy/config.json
