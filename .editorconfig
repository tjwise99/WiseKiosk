# Editor consistency, complementing .gitattributes (which enforces LF at commit).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go is tab-indented by gofmt; do not fight it.
[*.go]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
